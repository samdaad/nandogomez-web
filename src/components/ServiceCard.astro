---
interface Props { title: string }
const { title } = Astro.props;
---
<article>
  <span class="icon"><slot name="icon" /></span>
  <h3>{title}</h3>
  <p><slot /></p>
</article>
<style>
  article {
    flex: 1 1 320px; min-width: 0; min-height: 280px; display: flex; flex-direction: column; gap: var(--space-4);
    padding: var(--space-8); background: var(--surface); border: var(--hairline) solid var(--border); border-radius: var(--radius-lg);
  }
  .icon { display: flex; color: var(--lime); }
  h3 { margin: 0; font-size: 24px; font-weight: 600; letter-spacing: -0.02em; }
  p { margin: 0; color: var(--ink-muted); }
</style>
