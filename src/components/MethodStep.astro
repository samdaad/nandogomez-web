---
interface Props { num: string; title: string }
const { num, title } = Astro.props;
---
<li>
  <p class="num">{num} — {title}</p>
  <p><slot /></p>
</li>
<style>
  li { flex: 1 1 240px; min-width: 0; }
  p { margin: 0; color: var(--ink-muted); }
  .num { margin-bottom: var(--space-3); font-family: var(--font-mono); font-size: 14px; color: var(--lime); }
</style>
