---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---
<BaseLayout title="Página no encontrada — Nando Gómez" description="La página que buscas no existe o ha cambiado de dirección." canonical={false}>
  <Header />
  <main id="main" tabindex="-1">
    <h1>Página no encontrada</h1>
    <p>La dirección que has abierto no existe o ha cambiado. <a href="/">Vuelve al inicio</a>.</p>
  </main>
</BaseLayout>
<style>
  main { max-width: 760px; margin: 0 auto; padding: 88px var(--space-6) var(--space-28); }
  h1 { margin: 0 0 var(--space-4); font-size: clamp(40px, 5vw, 64px); font-weight: 600; letter-spacing: -0.04em; line-height: 1; overflow-wrap: anywhere; }
  p { margin: 0; color: var(--ink-muted); }
  p a { color: var(--ink); }
</style>
