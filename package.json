{
  "name": "nandogomez-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-release.mjs",
    "preview": "astro preview",
    "typecheck": "astro check --minimumFailingSeverity warning",
    "test": "vitest run --coverage",
    "test:dist": "vitest run -c vitest.dist.config.ts",
    "check:release": "node scripts/check-release.mjs --strict"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "astro": "7.4.2",
    "parse5": "8.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3"
  }
}
